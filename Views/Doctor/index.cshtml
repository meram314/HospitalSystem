
@model IEnumerable<HospitalSystem.Models.Doctor>

<div class="container mt-5">

    <h1 class="text-center mb-4">Our Doctors</h1>
    <!-- Filter Section -->
    <section class="py-3 filter-bar">
        <div class="row p-3 rounded bg-light mb-4">
            <div class="col-12">

                <form asp-controller="Doctor" asp-action="Index" method="get">
                    <div class="row g-3 align-items-end">

                        <!-- Filter by Doctor Name -->
                        <div class="col-md-5">
                            <label class="form-label">Doctor Name</label>
                            <input type="text"
                                   name="name"
                                   value="@ViewBag.Name"
                                   class="form-control"
                                   placeholder="Search by doctor name..." />
                        </div>

                        <!-- Filter by Specialization -->
                        <div class="col-md-5">
                            <label class="form-label">Specialization</label>

                            <select name="specializationId" class="form-select">
                                <option value="">All Specializations</option>

                                @foreach (var specialization in ViewBag.Specialization)
                                {
                                    <option value="@specialization.SpecializationId"
                                            selected="@(ViewBag.SpecializationId != null && (int)ViewBag.SpecializationId == specialization.SpecializationId)">
                                        @specialization.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Search Button -->
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                Search
                            </button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </section>

    <!-- Doctors Cards -->
    <div class="row">

        @foreach (var doctor in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    <img src="~/images/@doctor.image"
                         class="card-img-top"
                         style="height:250px; object-fit:cover;"
                         alt="@doctor.Name" />

                    <div class="card-body text-center">
                        <h4 class="card-title">
                            @doctor.Name
                        </h4>

                        <p class="card-text">
                            @doctor.Specialization.Name
                        </p>

                        <a asp-controller="Appointment"
                           asp-action="Create"
                           asp-route-doctorId="@doctor.DoctorId"
                           class="btn btn-primary">
                            Book Appointment
                        </a>
                    </div>

                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center">
                <p class="alert alert-info">No doctors found.</p>
            </div>
        }

    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">

                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="Doctor"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-name="@ViewBag.Name"
                           asp-route-specializationId="@ViewBag.SpecializationId">
                            Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Doctor"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-name="@ViewBag.Name"
                           asp-route-specializationId="@ViewBag.SpecializationId">
                            @i
                        </a>
                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="Doctor"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-name="@ViewBag.Name"
                           asp-route-specializationId="@ViewBag.SpecializationId">
                            Next
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

</div>

