<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HospitalSystem</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="~/vendor/bootstrap-icons/bootstrap-icons.css" />

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/css/main.css" />

    <!-- Your CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/HospitalSystem.styles.css" asp-append-version="true" />
    

</head>

<body>

    <!-- ================= HEADER ================= -->

    <header id="header" class="header fixed-top">

        <!-- Top Bar -->
        <div class="topbar d-flex align-items-center dark-background">

            <div class="container d-flex justify-content-center justify-content-md-between">

                <div class="contact-info d-flex align-items-center">

                    <i class="bi bi-envelope d-flex align-items-center">
                        <a href="mailto:contact@example.com">
                            contact@example.com
                        </a>
                    </i>

                    <i class="bi bi-phone d-flex align-items-center ms-4">
                        <span>+20 100 000 0000</span>
                    </i>

                </div>

                <div class="social-links d-none d-md-flex align-items-center">

                    <a href="#!" class="facebook">
                        <i class="bi bi-facebook"></i>
                    </a>

                    <a href="#!" class="instagram">
                        <i class="bi bi-instagram"></i>
                    </a>

                    <a href="#!" class="linkedin">
                        <i class="bi bi-linkedin"></i>
                    </a>

                </div>

            </div>

        </div>


        <!-- Branding / Navbar -->
        <div class="branding d-flex align-items-center">

            <div class="container position-relative d-flex align-items-center justify-content-between">

                <!-- Logo -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="logo d-flex align-items-center">

                    <h1 class="sitename">Clinic</h1>

                </a>


                <!-- Navbar -->
                <nav id="navmenu" class="navmenu">

                    <ul>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a href="#about">
                                About
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Doctor"
                               asp-action="Index">
                                Doctors
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Appointment"
                               asp-action="Index">
                                Appointments
                            </a>
                        </li>

                        <li>
                            <a href="#contact">
                                Contact
                            </a>
                        </li>

                    </ul>

                    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>

                </nav>

            </div>

        </div>

    </header>


    <!-- ================= MAIN CONTENT ================= -->

    <main class="main">

        @RenderBody()

    </main>


    <!-- ================= FOOTER ================= -->

    <footer id="footer" class="footer-16">

        <div class="container">

            <div class="footer-bottom-content">

                <!-- Copyright -->
                <div class="copyright">

                    <p>
                        © <span class="sitename">Clinic</span>.
                        All rights reserved.
                    </p>

                </div>


                <!-- Links -->
                <div class="legal-links">

                    <a href="#!">
                        Privacy Policy
                    </a>

                    <a href="#!">
                        Terms of Service
                    </a>

                    <a href="#!">
                        Cookie Policy
                    </a>

                    <div class="credits">

                        Designed by
                        <a href="https://bootstrapmade.com/">
                            BootstrapMade
                        </a>

                        . Distributed by

                        <a href="https://themewagon.com"
                           target="_blank">
                            ThemeWagon
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Template JS -->
    <script src="~/vendor/aos/aos.js"></script>

    <script src="~/vendor/glightbox/js/glightbox.min.js"></script>

    <script src="~/vendor/purecounter/purecounter_vanilla.js"></script>

    <script src="~/vendor/swiper/swiper-bundle.min.js"></script>

    <script src="~/js/main.js"></script>

    <!-- Your JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>